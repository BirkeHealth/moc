# Required environment variables for the medical-note-api service.
# Copy this file to .env for local development (never commit .env).

# -- RingCentral JWT auth -----------------------------------------------------
# The JWT private key credential obtained from the RingCentral Developer
# Console for your app. It is exchanged server-side for an OAuth access token
# using the jwt-bearer grant type before every SMS call (token is cached).
RINGCENTRAL_JWT=

# The Client ID of your RingCentral app (found in Developer Console).
RINGCENTRAL_CLIENT_ID=

# The Client Secret of your RingCentral app (found in Developer Console).
RINGCENTRAL_CLIENT_SECRET=

# -- SMS sender ----------------------------------------------------------------
# The RingCentral phone number used as the SMS sender, in E.164 format.
# Example: +13055550123
# The number must be SMS-capable and must belong to the account/extension
# authorized by the JWT above.
RINGCENTRAL_FROM_NUMBER=

# -- CORS ----------------------------------------------------------------------
# Comma-separated list of frontend origins that are allowed to call this API.
# Required when the frontend and API are on different origins in production.
# Example: https://medical-note-tool.onrender.com
# Not required in local development because the Vite dev server proxies /api.
CORS_ORIGIN=

# -- Server --------------------------------------------------------------------
# Port the HTTP server listens on. Defaults to 3001.
PORT=3001
